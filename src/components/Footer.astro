---
import navigation from "../data/navigation.json";
const {active} = Astro.props;
---
<footer class="">
    <div class="container-xl">
        <div class="row">
            <div class="col-md-6">
                <h5>ABOUT US</h5>
                <p class="footer-about-text">无锡市泽嘉科技有限公司位于无锡市锡山区，研发、制造和销售机械传动件。产品包括万向轴、膜片联轴器、鼓形齿式联轴器、皮带轮及链传动部件，并可按客户图纸加工非标零件。</p>
            </div>
            <div class="col-md-3">
                <h6>联系我们</h6>
                <ul class="list-unstyled">
                    <li>联系人：张先生</li>
                    <li><i class="icon icon-map-marker-alt"></i> 无锡市锡山区</li>
                    <li><i class="icon icon-phone-alt"></i> <a href="tel:+8615805111666">158 0511 1666</a></li>
                    <li><i class="icon icon-envelope"></i> <a href="mailto:zejiatech@gmail.com">zejiatech@gmail.com</a></li>
                    <li><i class="icon icon-globe-americas"></i> <a href="https://azejia.com/">azejia.com</a></li>
                </ul>
            </div>
            <div class="col-md-3">
                <h6>泽嘉官网</h6>
                <a href="https://azejia.com/contact/"><img src="/zejia/contact-qr.svg" width="128" height="128" alt="扫码打开泽嘉官网联系页" style="background:white" /></a>
            </div>
        </div>
    </div>
    <div class="footer-bottom">
        <div class="container-xl">
            <div class="row">
                <div class="col-md-6">
                    <div class="footer-link">{navigation.map(item => <a class:list={[{active: item.href === active}]} href={item.href}>{item.label}</a>)}</div>
                </div>
                <div class="col-md-6">
                    <p class="footer-copyright">版权所有 © {new Date().getFullYear()} 无锡市泽嘉科技有限公司</p>
                </div>
            </div>
        </div>
    </div>
</footer>
<div class="side-share">
    <div class="share-item">
        <div class="share-link" role="button" tabindex="0" aria-label="返回顶部">
            <span class="share-ico totop"> </span>
        </div>
    </div>
</div>

